{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build && cd .. && node copyDist.js && node scripts/submit-to-bing.js",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/brandfetch-search", "destination": "/api/brandfetch-search.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
